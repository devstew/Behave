# Copy to .env.local and replace these four values with your Firebase web config.
# These web identifiers are public; Firestore rules enforce data protection.
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id

# Local testing only. Never set this to true on Vercel.
VITE_USE_FIREBASE_EMULATORS=false
